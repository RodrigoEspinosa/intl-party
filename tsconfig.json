{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@intl-party/core": ["./packages/core/src"],
      "@intl-party/react": ["./packages/react/src"],
      "@intl-party/nextjs/client": ["./packages/nextjs/src/client-exports.ts"],
      "@intl-party/nextjs": ["./packages/nextjs/src"],
      "@intl-party/cli": ["./packages/cli/src"],
      "@intl-party/eslint-plugin": ["./packages/eslint-plugin/src"]
    }
  },
  "include": ["packages/*/src/**/*", "examples/*/src/**/*", "apps/*/src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
