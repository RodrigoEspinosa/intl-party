{
  "name": "@intl-party/eslint-plugin",
  "version": "1.6.0",
  "description": "ESLint plugin for IntlParty - detect hardcoded strings and enforce i18n best practices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "i18n",
    "internationalization",
    "typescript",
    "hardcoded-strings",
    "eslintplugin",
    "l10n",
    "localization",
    "react",
    "jsx"
  ],
  "author": "RodrigoEspinosa",
  "license": "MIT",
  "homepage": "https://github.com/RodrigoEspinosa/intl-party#readme",
  "bugs": {
    "url": "https://github.com/RodrigoEspinosa/intl-party/issues"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.71.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript-eslint/rule-tester": "8.71.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RodrigoEspinosa/intl-party.git",
    "directory": "packages/eslint-plugin"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
