{
  "name": "@intl-party/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive, type-safe internationalization library for modern web applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/RodrigoEspinosa/intl-party.git"
  },
  "homepage": "https://github.com/RodrigoEspinosa/intl-party#readme",
  "bugs": {
    "url": "https://github.com/RodrigoEspinosa/intl-party/issues"
  },
  "license": "MIT",
  "author": "RodrigoEspinosa",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "VITE_CJS_IGNORE_WARNING=true turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:types": "tsc -p type-tests/registered && tsc -p type-tests/unregistered",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!example-* --filter=!@intl-party/example-* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "pnpm": {
    "overrides": {
      "@typescript-eslint/utils": "8.71.0",
      "@typescript-eslint/parser": "8.71.0",
      "@typescript-eslint/eslint-plugin": "8.71.0",
      "@typescript-eslint/rule-tester": "8.71.0"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  }
}
